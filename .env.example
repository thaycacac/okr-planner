# Copy to .env (never commit .env).

APP_ENV=dev
DATABASE_URL=sqlite:///./okr_planner.db
# Origins allowed to call the backend directly from the browser. They also pass the cross-site
# write check; the proxied frontend is same-origin and needs no entry.
CORS_ORIGINS=["http://localhost:3000"]

# Shared access password: store only the argon2 hash, generated with
#   cd backend && python -m app.hash_password
# Keep the single quotes: the hash contains `$`, which docker compose would interpolate.
APP_PASSWORD_HASH=''
# Signs session cookies; APP_ENV=prod requires >= 32 random chars
# (python -c "import secrets; print(secrets.token_urlsafe(48))"). Changing it signs everyone out.
SESSION_SECRET=change-me
SESSION_MAX_AGE_HOURS=168
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=60
# Each further lock doubles, up to this many seconds.
LOGIN_LOCK_MAX_SECONDS=900
# Peers allowed to report the client IP for login rate limiting (IPs or CIDRs of the Next.js
# proxy). Empty = every request is keyed by its connecting address, so behind a proxy all users
# share one bucket. On Railway set the private-network range of the frontend service and
# CLIENT_IP_HEADER=x-real-ip (set by Railway's edge; X-Forwarded-For arrives with extra hops).
TRUSTED_PROXY_IPS=[]
CLIENT_IP_HEADER=x-forwarded-for

# auto = local if Ollama answers, otherwise openai
LLM_PROVIDER=auto

LOCAL_LLM_BASE_URL=http://localhost:11434
# ollama | openai_compatible (LM Studio, vLLM)
LOCAL_LLM_API_STYLE=ollama
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_CONCURRENCY=1
LOCAL_LLM_TIMEOUT_SECONDS=180
# Max tokens the local model may generate per step; a truncated answer is retried.
LOCAL_LLM_NUM_PREDICT_CLARIFY=2048
LOCAL_LLM_NUM_PREDICT_DECOMPOSE=4096
LOCAL_LLM_NUM_PREDICT_DEDUP=1024

OPENAI_API_KEY=
OPENAI_MODEL_CLARIFY=gpt-4o-mini
OPENAI_MODEL_DECOMPOSE=gpt-4o-mini
OPENAI_MODEL_DEDUP=gpt-4o-mini
OPENAI_CONCURRENCY=5

# Frontend: the browser calls /api on the frontend origin and Next.js forwards
# it to BACKEND_INTERNAL_URL (read at `next build`; docker compose uses http://backend:8000).
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api

# Gemini (OpenAI-compatible endpoint) and Claude via the local `claude` CLI (uses its own login).
GEMINI_API_KEY=
GEMINI_MODEL_CLARIFY=gemini-3.1-flash-lite
GEMINI_MODEL_DECOMPOSE=gemini-3.1-flash-lite
GEMINI_MODEL_DEDUP=gemini-3.1-flash-lite
CLAUDE_CLI_PATH=claude
CLAUDE_MODEL_CLARIFY=sonnet
CLAUDE_MODEL_DECOMPOSE=sonnet
CLAUDE_MODEL_DEDUP=haiku
